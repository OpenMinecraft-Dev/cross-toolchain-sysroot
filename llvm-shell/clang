#!/bin/bash
DIR=$(cd $(dirname $0); pwd)/..
TRIPPLE=$(cat $(cd $(dirname $0); pwd)/target-tripple)
FLAGS=$(cat $(cd $(dirname $0); pwd)/flags)
exec /usr/bin/clang --target=$TRIPPLE $FLAGS --sysroot=$DIR/sysroot -isystem $DIR/sysroot/usr/include/c++/15 -fuse-ld=lld -Wno-unused-command-line-argument "$@"
